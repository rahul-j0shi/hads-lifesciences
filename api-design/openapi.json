{
  "openapi": "3.1.0",
  "info": {
    "title": "HADS Prototype API",
    "version": "0.1.0",
    "description": "Design contract only; endpoints are not implemented."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Planned local API"
    }
  ],
  "security": [],
  "paths": {
    "/api/v1/welcome": {
      "get": {
        "operationId": "getWelcome",
        "summary": "getWelcome",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-ID": {
                "description": "Generated or validated correlation identifier.",
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "public, max-age=60"
                }
              },
              "Vary": {
                "description": "Includes Origin when CORS response behavior varies by request origin. Preserve other variation fields.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WelcomeResponse"
                },
                "example": {
                  "name": "HADS Lifesciences",
                  "message": "Website coming soon."
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "summary": "getLiveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-ID": {
                "description": "Generated or validated correlation identifier.",
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                },
                "example": {
                  "status": "alive"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "getReadiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-ID": {
                "description": "Generated or validated correlation identifier.",
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                },
                "example": {
                  "status": "ready"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Service Unavailable",
            "headers": {
              "X-Request-ID": {
                "description": "Generated or validated correlation identifier.",
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Service Unavailable",
                  "status": 503,
                  "detail": "A required dependency is unavailable.",
                  "request_id": "example-request-id"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "const": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "WelcomeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "message"
        ],
        "properties": {
          "name": {
            "type": "string",
            "const": "HADS Lifesciences"
          },
          "message": {
            "type": "string",
            "const": "Website coming soon."
          }
        }
      },
      "LivenessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "alive"
          }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ready"
          }
        }
      }
    },
    "responses": {
      "InternalError": {
        "description": "Internal Server Error",
        "headers": {
          "X-Request-ID": {
            "description": "Generated or validated correlation identifier.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Internal Server Error",
              "status": 500,
              "detail": "An unexpected error occurred.",
              "request_id": "example-request-id"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not Found",
        "headers": {
          "X-Request-ID": {
            "description": "Generated or validated correlation identifier.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Not Found",
              "status": 404,
              "detail": "The requested resource was not found.",
              "request_id": "example-request-id"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "Method Not Allowed",
        "headers": {
          "X-Request-ID": {
            "description": "Generated or validated correlation identifier.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "Allow": {
            "description": "Supported HTTP methods for the requested resource.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Method Not Allowed",
              "status": 405,
              "detail": "The method is not allowed for this resource.",
              "request_id": "example-request-id"
            }
          }
        }
      }
    }
  }
}
