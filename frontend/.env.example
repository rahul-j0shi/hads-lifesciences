# Safe template. COMMITTED. Copy to frontend/.env.
# VITE_* values are PUBLIC once built into the bundle.
# Never put a secret, database URI or private key in a VITE_ variable.
# Contract: ../infrastructure/README.md

# HTTPS origin with no trailing slash in hosted environments.
# Local: http://localhost:8000   Hosted: https://<your-api>.onrender.com
VITE_API_BASE_URL=http://localhost:8000
