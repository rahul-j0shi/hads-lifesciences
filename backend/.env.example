# Safe template. COMMITTED. Copy to backend/.env and fill in real values.
# Never put a real credential in this file.
# Contract: ../infrastructure/README.md  Runbook: ../documentation/setup-and-hosting.md

# local | test | prototype
APP_ENV=local

# SECRET, backend only. Obtain from MongoDB Atlas: Connect -> Drivers -> Python.
# URL-encode any reserved character in the password. Keep TLS verification on.
# Hosted values live in the provider dashboard, never in this repository.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=hads_prototype

# Exact origins only, JSON array, double quotes, no trailing slash, no wildcard.
# Hosted: ["https://<your-site>.netlify.app"]
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO

# PORT is injected by the hosting platform. Do not set it locally.
