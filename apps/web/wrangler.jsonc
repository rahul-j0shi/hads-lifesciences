// Cloudflare Worker that serves the built site as static assets. There is no
// Worker script ("main"): every request is answered from ./dist at the edge,
// which is free and unmetered. Custom domains are attached in the dashboard.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hads-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
