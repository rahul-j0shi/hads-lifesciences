---
import { VISION } from '../content'
---

<section class="section" id="vision" aria-labelledby="vision-heading">
  <div class="container grid">
    <div class="head">
      <p class="eyebrow">{VISION.eyebrow}</p>
      <h2 class="h2" id="vision-heading">{VISION.heading}</h2>
    </div>
    <div class="body">
      <blockquote>{VISION.quote}</blockquote>
      {VISION.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 2rem; }
  .head { display: grid; gap: 1rem; align-content: start; }
  .body { display: grid; gap: 1.25rem; max-width: 40rem; }
  blockquote {
    margin: 0 0 0.5rem;
    padding-left: 1.4rem;
    border-left: 3px solid var(--pink);
    font: 600 clamp(1.45rem, 1.2rem + 1vw, 1.95rem)/1.3 var(--font-display);
    color: var(--navy);
    text-wrap: balance;
  }
  p { font-size: 1.06rem; color: var(--ink); text-wrap: pretty; }

  @media (min-width: 900px) {
    .grid { grid-template-columns: 5fr 7fr; gap: 4rem; }
    .head { position: sticky; top: calc(var(--header-h) + 2rem); }
  }
</style>
