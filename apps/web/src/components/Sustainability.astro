---
import { SUSTAINABILITY, VALUES } from '../content'
import Icon from './Icon.astro'

const { image } = SUSTAINABILITY
---

<section class="section" id="sustainability" aria-labelledby="sustainability-heading">
  <div class="container grid">
    <figure>
      <img
        src={image.src}
        srcset={image.srcset}
        sizes="(min-width: 960px) 560px, 100vw"
        width={image.width}
        height={image.height}
        alt={image.alt}
        loading="lazy"
        decoding="async"
      />
      <figcaption>{image.caption}</figcaption>
    </figure>

    <div>
      <div class="section-head">
        <p class="eyebrow">{SUSTAINABILITY.eyebrow}</p>
        <h2 class="h2" id="sustainability-heading">{SUSTAINABILITY.heading}</h2>
      </div>
      <ul class="commitments" role="list">
        {
          SUSTAINABILITY.commitments.map((item) => (
            <li>
              <span class="badge">
                <Icon name={item.icon} />
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Brand themes, not credentials: no seals, checkmarks or counts. -->
  <div class="container">
    <ul class="values" role="list" aria-label="Our values">
      {
        VALUES.map((value) => (
          <li>
            <span class="value-icon">
              <Icon name={value.icon} size={20} />
            </span>
            {value.label}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid { display: grid; gap: clamp(2.5rem, 1.5rem + 4vw, 5rem); align-items: center; }

  figure { position: relative; }
  figure img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.85);
    color: var(--muted);
    font-size: 0.72rem;
  }

  .commitments { display: grid; gap: 1.5rem; }
  .commitments li { display: grid; grid-template-columns: auto 1fr; gap: 1.1rem; }
  .badge {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-ink);
  }
  .commitments li:nth-child(even) .badge { background: var(--blue-soft); color: var(--blue); }
  h3 { font: 600 var(--fs-h3)/1.3 var(--font-display); color: var(--navy); }
  .commitments p { margin-top: 0.35rem; color: var(--muted); }

  .values {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--canvas);
  }
  .values li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 1.25rem 0.75rem;
    color: var(--navy);
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
  }
  .values li:nth-child(odd) { border-right: 1px solid var(--line); }
  .values li:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  .value-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--surface);
    color: var(--pink-ink);
    box-shadow: var(--shadow-sm);
  }
  .values li:nth-child(even) .value-icon { color: var(--blue); }

  @media (min-width: 960px) {
    .grid { grid-template-columns: 1.05fr 1fr; }
  }
  @media (max-width: 859px) {
    .values li { flex-direction: column; gap: 0.55rem; font-size: 0.74rem; letter-spacing: 0.06em; }
  }
  @media (min-width: 860px) {
    .values { grid-template-columns: repeat(4, 1fr); }
    .values li { border: 0 !important; }
    .values li + li { border-left: 1px solid var(--line) !important; }
  }
</style>
