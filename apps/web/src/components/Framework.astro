---
import { FRAMEWORK, SITE } from '../content'
---

<section class="section section--canvas framework" id="framework" aria-labelledby="framework-heading">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">{FRAMEWORK.eyebrow}</p>
      <h2 class="h2" id="framework-heading">{FRAMEWORK.heading}</h2>
    </div>

    <ol class="pillars" role="list">
      {
        FRAMEWORK.pillars.map((pillar) => (
          <li class:list={['card', 'pillar', pillar.accent]}>
            <div class="emblem">
              <img src={pillar.emblem.src} alt="" width={pillar.emblem.width} height={pillar.emblem.height} loading="lazy" />
            </div>
            <h3>
              <span class="visually-hidden">{pillar.letter}: </span>
              {pillar.title}
            </h3>
            <p class="subline">{pillar.subline}</p>
            <p class="body">{pillar.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="rail">
      <span class="arm" aria-hidden="true"></span>
      <p>
        {SITE.tagline.map((word, i) => <span class={i === 1 ? 'blue' : 'pink'}>{word}</span>)}
      </p>
      <span class="arm" aria-hidden="true"></span>
    </div>
    <p class="closing"><strong>{SITE.name}:</strong> {FRAMEWORK.closing}</p>
    <p class="note">{FRAMEWORK.scopeNote}</p>
  </div>
</section>

<style>
  .framework {
    background:
      url('/images/constellation.svg') center / cover no-repeat,
      var(--canvas);
  }

  .pillars {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr));
  }
  .pillar {
    --accent: var(--pink);
    --accent-ink: var(--pink-ink);
    --accent-soft: var(--pink-soft);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem 1.25rem 1.75rem;
    overflow: hidden;
    transition: transform 220ms ease, box-shadow 220ms ease;
  }
  .pillar.blue { --accent: var(--blue); --accent-ink: var(--blue); --accent-soft: var(--blue-soft); }
  .pillar::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--accent);
  }
  @media (hover: hover) {
    .pillar:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  }

  .emblem {
    display: grid;
    place-items: center;
    height: 11rem;
    margin-bottom: 0.9rem;
    border-radius: var(--radius-sm);
    background: radial-gradient(circle at 50% 40%, #fff 0%, var(--accent-soft) 100%);
  }
  .emblem img { height: 7.5rem; width: auto; }

  h3 {
    font: 600 var(--fs-h3)/1.25 var(--font-display);
    color: var(--navy);
    font-size: 1.4rem;
    padding-inline: 0.25rem;
  }
  .subline {
    padding-inline: 0.25rem;
    color: var(--accent-ink);
    font-size: 0.8rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .body { padding-inline: 0.25rem; color: var(--muted); font-size: 0.97rem; }

  /* Phones: emblem beside the title instead of above it, so four cards
     take roughly half the scrolling. */
  @media (max-width: 559px) {
    .pillar {
      display: grid;
      grid-template-columns: 5.5rem 1fr;
      grid-template-areas: 'emblem title' 'emblem subline' 'body body';
      column-gap: 1rem;
      row-gap: 0.35rem;
      align-items: center;
      padding: 1.25rem 1.25rem 1.4rem;
    }
    .emblem { grid-area: emblem; height: 5.5rem; margin: 0; align-self: start; }
    .emblem img { height: 3.75rem; }
    h3 { grid-area: title; align-self: end; padding: 0; font-size: 1.25rem; }
    .subline { grid-area: subline; align-self: start; padding: 0; }
    .body { grid-area: body; padding: 0; margin-top: 0.75rem; }
  }

  .rail {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  .arm {
    flex: 0 1 9rem;
    height: 14px;
    border: 1.5px solid var(--pink);
    border-top: 0;
    border-right: 0;
  }
  .arm:last-child { transform: scaleX(-1); }
  .rail p {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    white-space: nowrap;
    font-size: clamp(0.8rem, 0.7rem + 0.4vw, 1rem);
    font-weight: 800;
    letter-spacing: clamp(0.04em, -0.06em + 0.6vw, 0.2em);
    text-transform: uppercase;
  }
  .rail .pink { color: var(--pink-ink); }
  .rail .blue { color: var(--blue); }
  .rail span + span::before { content: '•'; margin-right: 0.6rem; color: var(--muted); }
  @media (max-width: 560px) { .arm { display: none; } }

  .closing {
    max-width: 42rem;
    margin: 1rem auto 0;
    text-align: center;
    font-size: var(--fs-lead);
    color: var(--ink);
    text-wrap: balance;
  }
  .closing strong { color: var(--navy); }
  .note {
    max-width: 36rem;
    margin: 1.75rem auto 0;
    text-align: center;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
