---
import Page from '../layouts/Page.astro'
import { SITE } from '../content'
---

<Page title={`Page not found | ${SITE.name}`} index={false}>
  <main>
    <img src="/brand/logo.svg" alt={SITE.name} width="424" height="172" />
    <h1>This page could not be found.</h1>
    <a class="btn btn--primary" href="/">Back to the home page</a>
  </main>
</Page>

<style>
  main {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.5rem;
    padding: var(--gutter);
    text-align: center;
    background: var(--canvas);
  }
  img { width: min(18rem, 70vw); }
  h1 { font: 600 var(--fs-h3)/1.3 var(--font-display); color: var(--navy); font-size: 1.6rem; }
</style>
